# Optional: T3 Connect source builds
# Builds leave cloud features off while these values are empty. To turn T3 Connect
# on, copy this file to `.env` and fill in a Clerk instance and relay you run.
# They are public identifiers that builds embed, not secrets.
# Do not add server-side secrets to this file.

# Your Clerk instance, from the Clerk Dashboard: the publishable key under API keys,
# the name of the JWT template the relay verifies (infra/relay expects `t3-relay`),
# and the client ID of a public OAuth application for the CLI.
T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your relay's HTTPS origin, such as https://relay.example.com. Deploying
# `infra/relay` writes it to `.env` for you.
T3CODE_RELAY_URL=

# Optional: hosted app origin. The CLI's out-of-band OAuth flow defaults to
# upstream's https://app.t3.codes; mobile builds offer thread links only when it is set.
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...

# Weavewing mobile accounts. Preview and production app builds on both
# platforms fail without these; iOS builds also need T3CODE_APPLE_TEAM_ID (the
# same team signs the macOS app above). Development builds work without them.
# Over-the-air updates are off unless T3CODE_MOBILE_UPDATES_ENABLED=1.
# T3CODE_CLERK_PUBLISHABLE_KEY adds the passkey and Sign in with Apple
# entitlements, and T3CODE_HOSTED_APP_URL adds thread links. See
# docs/operations/weavewing-ios-release.md.
T3CODE_EXPO_OWNER=
T3CODE_EXPO_PROJECT_ID=
